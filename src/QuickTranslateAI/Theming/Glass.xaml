<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Liquid glass kontrol seti.
        Bulanıklığı DWM sağlar; buradaki katmanlar yalnızca spekülar kenar,
        üst parlama ve yarı saydam dolgudan oluşur.
    -->

    <FontFamily x:Key="App.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="App.DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CornerRadius x:Key="App.CardRadius">14</CornerRadius>
    <CornerRadius x:Key="App.ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="App.ChipRadius">999</CornerRadius>

    <Style x:Key="FocusVisual.Soft" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource App.Accent}"
                            BorderThickness="2"
                            CornerRadius="10"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tipografi ===================== -->

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Text.Title" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource App.DisplayFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Subtitle" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Section" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Label" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Text.Body" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Caption" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================== Yüzeyler ===================== -->

    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.CardRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Surface.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="CornerRadius" Value="{StaticResource App.ChipRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Düğmeler ===================== -->

    <Style x:Key="Button.Glass" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <!-- Üstten gelen ince parlama: cam yüzeyin ışık kırılması. -->
                        <Border x:Name="Sheen"
                                Background="{DynamicResource App.CardHighlight}"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                IsHitTestVisible="False"
                                Opacity="0.55" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillPressed}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Accent" BasedOn="{StaticResource Button.Glass}" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow"
                                Margin="0,2,0,-2"
                                Background="{DynamicResource App.Accent}"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                IsHitTestVisible="False"
                                Opacity="0.35">
                            <Border.Effect>
                                <BlurEffect KernelType="Gaussian" Radius="12" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Root"
                                Background="{DynamicResource App.Accent}"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <Border Background="{DynamicResource App.CardHighlight}"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                IsHitTestVisible="False"
                                Opacity="0.3" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.AccentHover}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.AccentPressed}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Subtle" BasedOn="{StaticResource Button.Glass}" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{StaticResource App.ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Icon" BasedOn="{StaticResource Button.Subtle}" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== Girdi alanları ===================== -->

    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.Password" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                SnapsToDevicePixels="True" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Açılır liste ===================== -->

    <!--
        Açık ItemTemplate kullanıyoruz. DisplayMemberPath, özel ComboBox şablonunda
        SelectionBoxItemTemplate'i doldurmadığı için seçili öğe nesnenin ToString()
        çıktısıyla görünüyordu.
    -->
    <DataTemplate x:Key="Item.Label">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="Item.DisplayName">
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Input.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Margin="4,1"
                            Background="Transparent"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Input.ComboItem}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Root"
                                Grid.ColumnSpan="2"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                SnapsToDevicePixels="True" />

                        <Border Grid.ColumnSpan="2"
                                Background="{DynamicResource App.CardHighlight}"
                                CornerRadius="{StaticResource App.ControlRadius}"
                                IsHitTestVisible="False"
                                Opacity="0.4" />

                        <!--
                            Düzenlenebilir modda yalnızca ok alanı açılır listeyi açar;
                            metin alanı yazmaya ayrılır. Aksi halde kutunun tamamı tıklanır.
                        -->
                        <ToggleButton x:Name="Toggle"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"
                                          TextBlock.Foreground="{DynamicResource App.Text}" />

                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Margin="{TemplateBinding Padding}"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource App.Accent}"
                                 Foreground="{DynamicResource App.Text}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 SelectionBrush="{DynamicResource App.Accent}"
                                 SelectionOpacity="0.3"
                                 Visibility="Collapsed">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <Path Grid.Column="1"
                              Width="9"
                              Height="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 4.5 5 L 9 0"
                              IsHitTestVisible="False"
                              Stretch="None"
                              Stroke="{DynamicResource App.TextSecondary}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.4" />

                        <Popup x:Name="PART_Popup"
                               Grid.ColumnSpan="2"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,6,0,10"
                                    Background="{DynamicResource App.CardFillStrong}"
                                    BorderBrush="{DynamicResource App.CardStroke}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22"
                                                      Direction="270"
                                                      Opacity="0.28"
                                                      ShadowDepth="4"
                                                      Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer Margin="0,4" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Toggle" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Toggle" Property="Grid.ColumnSpan" Value="1" />
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Anahtar (toggle) ===================== -->

    <Style x:Key="Input.Switch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                VerticalAlignment="Center"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="999"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob"
                                     Width="14"
                                     Height="14"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource App.TextSecondary}" />
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Kaydırma animasyonu yerine hizalama değiştiriliyor: açılışta
                             IsChecked=true olan anahtarın topuzu da doğru yerde durur. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource App.OnAccent}" />
                            <Setter TargetName="Knob" Property="Width" Value="16" />
                            <Setter TargetName="Knob" Property="Height" Value="16" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radyo düğmesi görünümlü seçim kartı; kurulum sihirbazında kullanılır. -->
    <Style x:Key="Input.OptionCard" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Sheen"
                                Background="{DynamicResource App.CardHighlight}"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                Opacity="0.4" />
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse x:Name="Outer"
                                         Stroke="{DynamicResource App.TextTertiary}"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot"
                                         Width="8"
                                         Height="8"
                                         Fill="{DynamicResource App.Accent}"
                                         Opacity="0" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== İnce kaydırma çubuğu ===================== -->

    <Style x:Key="ScrollBar.Slim" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="5"
                                                    Background="{DynamicResource App.TextTertiary}"
                                                    CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Uygulamadaki tüm kaydırma çubukları ince cam görünümünü alır. -->
    <Style BasedOn="{StaticResource ScrollBar.Slim}" TargetType="ScrollBar" />

    <!-- ===================== Tepsi bağlam menüsü ===================== -->

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource App.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Margin="4,1"
                            Background="Transparent"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.Accent}"
                                       Text="✓"
                                       Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- True olmalı: WPF açılır pencerenin saydamlığını bu özelliğe göre açar,
             yuvarlak köşeler ve gölge ancak o zaman görünür. -->
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10"
                            MinWidth="208"
                            Background="{DynamicResource App.CardFillStrong}"
                            BorderBrush="{DynamicResource App.CardStroke}"
                            BorderThickness="1"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              Direction="270"
                                              Opacity="0.32"
                                              ShadowDepth="5"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel Margin="0,5" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Scroll.Glass" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

</ResourceDictionary>
