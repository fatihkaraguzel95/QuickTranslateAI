<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Koyu tema. Aynı anahtarlar; yalnızca değerler değişir. -->

    <Color x:Key="App.AccentColor">#4FA8FF</Color>
    <Color x:Key="App.AccentGlowColor">#7FC4FF</Color>
    <Color x:Key="App.ShadowColor">#66000000</Color>
    <Color x:Key="App.BorderAccentColor">#2E3A4A</Color>

    <SolidColorBrush x:Key="App.Accent" Color="#4FA8FF" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#6FBAFF" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#3B8FDE" />
    <SolidColorBrush x:Key="App.OnAccent" Color="#06121F" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#334FA8FF" />

    <SolidColorBrush x:Key="App.Text" Color="#F2F5F9" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#A6F2F5F9" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#66F2F5F9" />

    <SolidColorBrush x:Key="App.Surface" Color="#1B1D21" />

    <SolidColorBrush x:Key="App.GlassWash" Color="#26000000" />

    <SolidColorBrush x:Key="App.CardFill" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="App.CardFillStrong" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="App.CardStroke" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="App.CardHairline" Color="#59000000" />

    <LinearGradientBrush x:Key="App.CardHighlight" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.45" Color="#0DFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="App.ControlFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="App.ControlFillHover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="App.ControlFillPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="App.ControlStroke" Color="#2EFFFFFF" />

    <SolidColorBrush x:Key="App.Divider" Color="#1FFFFFFF" />

    <SolidColorBrush x:Key="App.Success" Color="#5BD98A" />
    <SolidColorBrush x:Key="App.SuccessSoft" Color="#265BD98A" />
    <SolidColorBrush x:Key="App.Danger" Color="#FF8A72" />
    <SolidColorBrush x:Key="App.DangerSoft" Color="#26FF8A72" />
    <SolidColorBrush x:Key="App.Warning" Color="#F2C14E" />

    <RadialGradientBrush x:Key="App.BlobA" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#664FA8FF" />
        <GradientStop Offset="1" Color="#004FA8FF" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="App.BlobB" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#528B6BFF" />
        <GradientStop Offset="1" Color="#008B6BFF" />
    </RadialGradientBrush>

</ResourceDictionary>
