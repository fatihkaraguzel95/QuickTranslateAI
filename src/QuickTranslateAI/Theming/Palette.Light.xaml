<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Açık tema. Renkler Windows 11 Fluent paletine yakın tutuldu. -->

    <Color x:Key="App.AccentColor">#0E6FD1</Color>
    <Color x:Key="App.AccentGlowColor">#3B9CFF</Color>
    <Color x:Key="App.ShadowColor">#2A1B3A5C</Color>
    <Color x:Key="App.BorderAccentColor">#D8E4F2</Color>

    <SolidColorBrush x:Key="App.Accent" Color="#0E6FD1" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#1A7FE0" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#0B5CAE" />
    <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#1A0E6FD1" />

    <SolidColorBrush x:Key="App.Text" Color="#15181C" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#8C15181C" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#5915181C" />

    <!-- Backdrop "Solid" seçildiğinde pencerenin opak zemini. -->
    <SolidColorBrush x:Key="App.Surface" Color="#F3F4F7" />

    <!-- Cam modunda DWM bulanıklığının üstüne binen ince sıcaklık katmanı. -->
    <SolidColorBrush x:Key="App.GlassWash" Color="#40FFFFFF" />

    <!-- Cam kart: yarı saydam dolgu + spekülar kenar. -->
    <SolidColorBrush x:Key="App.CardFill" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="App.CardFillStrong" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="App.CardStroke" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="App.CardHairline" Color="#14000000" />

    <LinearGradientBrush x:Key="App.CardHighlight" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#A8FFFFFF" />
        <GradientStop Offset="0.45" Color="#20FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="App.ControlFill" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="App.ControlFillHover" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="App.ControlFillPressed" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="App.ControlStroke" Color="#22000000" />

    <SolidColorBrush x:Key="App.Divider" Color="#14000000" />

    <SolidColorBrush x:Key="App.Success" Color="#0F7B35" />
    <SolidColorBrush x:Key="App.SuccessSoft" Color="#1A0F7B35" />
    <SolidColorBrush x:Key="App.Danger" Color="#C13515" />
    <SolidColorBrush x:Key="App.DangerSoft" Color="#1AC13515" />
    <SolidColorBrush x:Key="App.Warning" Color="#9A6400" />

    <!-- Arka planda yüzen yumuşak renk lekeleri; "sıvı" hissi veren katman. -->
    <RadialGradientBrush x:Key="App.BlobA" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#5A3B9CFF" />
        <GradientStop Offset="1" Color="#003B9CFF" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="App.BlobB" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#4A7C5CFF" />
        <GradientStop Offset="1" Color="#007C5CFF" />
    </RadialGradientBrush>

</ResourceDictionary>
